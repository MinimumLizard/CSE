<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CSE Terminal</title>
<meta name="description" content="Colombo Stock Exchange terminal: market tape, watchlist, disclosures. Session {{ session }}.">
<style>
:root{
  --bg:#0d0d0c; --surface:#161615; --surface-2:#1e1e1c; --rule:#2c2c29;
  --text:#ecebe6; --text-2:#b4b3aa; --muted:#7d7c74;
  --up:#3fb950; --dn:#f85149; --accent:#3987e5; --warn:#d29922; --warn-bg:#2b2410;
  --mono:ui-monospace,SFMono-Regular,"JetBrains Mono",Menlo,Consolas,"Liberation Mono",monospace;
  color-scheme:dark;
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--text);font:13px/1.45 var(--mono)}
a{color:var(--accent);text-decoration:none} a:hover{text-decoration:underline}
header{display:flex;flex-wrap:wrap;gap:4px 18px;align-items:baseline;padding:10px 16px;border-bottom:1px solid var(--rule);background:var(--surface)}
header h1{font-size:14px;margin:0;letter-spacing:.08em;text-transform:uppercase}
header .meta{color:var(--text-2)} header .meta b{color:var(--text);font-weight:600}
.banner{margin:8px 16px 0;padding:8px 12px;border:1px solid var(--warn);background:var(--warn-bg);color:#f2cc60;border-radius:4px}
.banner[hidden]{display:none}
main{display:grid;gap:12px;padding:12px 16px 24px;grid-template-columns:minmax(0,1fr)}
@media (min-width:1600px){main{grid-template-columns:minmax(0,2.2fr) minmax(0,1fr)} #panel-a{grid-column:1 / -1}}
@media (min-width:1000px) and (max-width:1599px){.feed{max-height:640px}}
section.panel{background:var(--surface);border:1px solid var(--rule);border-radius:6px;padding:10px 12px;min-width:0}
section.panel>h2{margin:0 0 8px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-2);display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
h3{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin:10px 0 4px;font-weight:600}
.grid-a{display:grid;gap:12px;grid-template-columns:minmax(0,1fr)}
@media (min-width:760px){.grid-a{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (min-width:1280px){.grid-a{grid-template-columns:repeat(4,minmax(0,1fr))}}
.card{background:var(--surface-2);border-radius:4px;padding:8px 10px;min-width:0}
.idx .lvl{font-size:20px;font-weight:600}
.idx .chg{margin-left:6px}
.chart{position:relative;height:110px;margin-top:6px}
.kv{display:grid;grid-template-columns:auto 1fr;gap:2px 12px}
.kv dt{color:var(--text-2)} .kv dd{margin:0;text-align:right}
.scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}
th,td{padding:3px 6px;white-space:nowrap;border-bottom:1px solid var(--rule)}
th{color:var(--muted);font-weight:500;text-align:right;font-size:11px;text-transform:uppercase;letter-spacing:.04em}
td{text-align:right} th.l,td.l{text-align:left}
tbody tr:hover{background:#ffffff08}
tr.grp td{color:var(--text-2);background:var(--surface-2);text-align:left;font-size:11px;letter-spacing:.1em;text-transform:uppercase;padding-top:6px}
.up{color:var(--up)} .dn{color:var(--dn)} .flat{color:var(--text-2)}
.mut{color:var(--muted)} .sm{font-size:11px}
.sym{font-weight:600} .trunc{display:inline-block;max-width:10em;overflow:hidden;text-overflow:ellipsis;vertical-align:bottom}
.card table{font-size:12px} .card th,.card td{padding:3px 4px}
#book td:first-child,#book th:first-child{position:sticky;left:0;background:var(--surface);z-index:1}
#book tr.grp td{position:static}
.name{color:var(--muted);max-width:180px;overflow:hidden;text-overflow:ellipsis;display:inline-block;vertical-align:bottom}
.excl{color:var(--warn);font-size:11px;margin-left:4px}
.star{color:var(--accent);margin-left:3px}
.rng{display:inline-flex;align-items:center;gap:6px}
.rng .bar{position:relative;width:64px;height:6px;background:#2f2f2c;border-radius:3px}
.rng .bar i{position:absolute;top:-2px;width:2px;height:10px;background:var(--text);border-radius:1px}
.flag{color:var(--warn);cursor:help}
.need{color:var(--muted);font-size:11px}
.toggle{display:inline-flex;border:1px solid var(--rule);border-radius:4px;overflow:hidden}
.toggle button{font:inherit;font-size:11px;background:transparent;color:var(--text-2);border:0;padding:3px 9px;cursor:pointer}
.toggle button[aria-pressed=true]{background:var(--accent);color:#fff}
.feed{list-style:none;margin:0;padding:0;max-height:1100px;overflow-y:auto}
.feed li{padding:6px 2px;border-bottom:1px solid var(--rule)}
.feed .top{display:flex;gap:8px;align-items:baseline;flex-wrap:wrap}
.feed .date{color:var(--muted)} .feed .co{color:var(--text-2)}
.feed .title{display:block;margin-top:2px;word-break:break-word}
.feed .cat{color:var(--muted);font-size:11px}
.tag{font-size:10px;text-transform:uppercase;letter-spacing:.06em;padding:0 5px;border-radius:3px;border:1px solid var(--rule);color:var(--text-2)}
.tag.dividend{border-color:#3fb95066;color:#7ee2a8} .tag.dealings{border-color:#d2992266;color:#f2cc60}
.tag.capital{border-color:#3987e566;color:#86b6ef} .tag.results{border-color:#9085e966;color:#b7aff5}
.tag.board{border-color:#e6676766;color:#f0a0a0}
.feed li[hidden]{display:none}
#panel-d{grid-column:1 / -1}
.note{color:var(--text-2);margin:0 0 8px}
.lab-assume{max-width:560px;margin:4px 0 10px}
.grid-d{display:grid;gap:12px;grid-template-columns:minmax(0,1fr);margin-top:8px}
@media (min-width:1000px){.grid-d{grid-template-columns:minmax(0,1.2fr) minmax(0,1fr)}}
.chart-lg{position:relative;height:320px}
details.pf{margin-top:8px;border:1px solid var(--rule);border-radius:4px;padding:6px 10px;background:var(--surface-2)}
details.pf summary{cursor:pointer;color:var(--text-2)}
.swatch{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:6px;vertical-align:baseline;background:var(--muted)}
.swatch[data-series=min_variance]{background:#3987e5}.swatch[data-series=risk_parity]{background:#d95926}
.swatch[data-series=max_sharpe]{background:#199e70}.swatch[data-series=equal_weight]{background:#c98500}
.swatch[data-series=market]{background:#d55181}.swatch[data-series=my_book]{background:#9085e9}
td.wrap{white-space:normal;min-width:16em}
.banner.preview{border-color:var(--accent);background:#0f2236;color:#9ec5f4}
footer{color:var(--muted);padding:0 16px 24px;font-size:11px}
</style>
</head>
<body>
<header>
  <h1>CSE Terminal</h1>
  <span class="meta">Session <b>{{ session }}</b></span>
  <span class="meta">Built <b>{{ built_slt }}</b> Sri Lanka time (UTC+05:30)</span>
  <span class="meta">History: {{ calendar_len }} sessions since {{ calendar_start or "—" }}</span>
  {% if ownership_page %}<span class="meta"><a href="ownership.html">Ownership →</a></span>{% endif %}
  {% if flows_page %}<span class="meta"><a href="flows.html">Money flows →</a></span>{% endif %}
</header>
{% if run.failed %}
<div class="banner" role="alert">⚠ The last data run failed ({{ run.last.run_at_utc }} UTC): {{ run.last.message }}. Figures below are from the last good session, {{ session }}.</div>
{% endif %}
<div class="banner" id="stale" role="alert" hidden></div>

<main>
<!-- Panel A ================================================================================ -->
<section class="panel" id="panel-a">
  <h2>A · Market tape</h2>
  <div class="grid-a">
    {% for h in headline %}
    <div class="card idx">
      <div class="mut sm">{{ h.label }}</div>
      <span class="lvl">{{ h.value | num }}</span>
      <span class="chg {{ h.change | cls }}">{{ h.change | signed }} ({{ h.pct | spct }})</span>
      {% if h.series %}<div class="chart"><canvas data-chart="{{ h.label }}" aria-label="{{ h.label }} level, last {{ h.series.dates | length }} sessions"></canvas></div>
      {% elif h.change is none %}<div class="need">change: needs the previous session's TRI</div>{% endif %}
    </div>
    {% endfor %}
  </div>

  <div class="grid-a" style="margin-top:12px">
    <div class="card">
      <h3 style="margin-top:0">Activity vs {{ avg_sessions }}-session average</h3>
      <dl class="kv">
        {% for key, label in [("turnover","Turnover"),("volume","Volume"),("trades","Trades")] %}
        {% set s = stats[key] %}
        <dt>{{ label }}</dt>
        <dd>{% if key == "turnover" %}{{ s.value | rs }}{% elif key == "volume" %}{{ s.value | vol }}{% else %}{{ s.value | num(0) }}{% endif %}
          <div class="sm">{% if s.ratio is not none %}<span class="{{ (s.ratio - 1) | cls }}">{{ (s.ratio - 1) | spct(0) }}</span> <span class="mut">vs avg</span>{% else %}<span class="need">avg: {{ s.needed }} more sessions needed</span>{% endif %}</div></dd>
        {% endfor %}
      </dl>
    </div>
    <div class="card">
      <h3 style="margin-top:0">Breadth (equities)</h3>
      <dl class="kv">
        <dt>Advancers</dt><dd class="up">+{{ breadth.up }}</dd>
        <dt>Decliners</dt><dd class="dn">{{ "−" }}{{ breadth.down }}</dd>
        <dt>Unchanged</dt><dd class="flat">±{{ breadth.flat }}</dd>
        <dt>Traded / listed cos.</dt><dd>{{ breadth.traded_all if breadth.traded_all is not none else "—" }} / {{ breadth.listed if breadth.listed is not none else "—" }}</dd>
      </dl>
    </div>
    <div class="card">
      <h3 style="margin-top:0">Foreign flow (equity)</h3>
      <dl class="kv">
        <dt>Purchases</dt><dd>{{ foreign.buy | rs }}</dd>
        <dt>Sales</dt><dd>{{ foreign.sell | rs }}</dd>
        <dt>Net</dt><dd class="{{ foreign.net | cls }}">{% if foreign.net is not none %}{{ "+" if foreign.net > 0 else ("−" if foreign.net < 0 else "±") }}{{ (foreign.net | abs) | rs }}{% else %}—{% endif %}</dd>
      </dl>
    </div>
    <div class="card">
      <h3 style="margin-top:0">Market valuation (CSE)</h3>
      <dl class="kv">
        <dt>P/E</dt><dd>{{ valuation.per | num(1) }}</dd>
        <dt>P/BV</dt><dd>{{ valuation.pbv | num(2) }}</dd>
        <dt>Div. yield</dt><dd>{{ valuation.dy | num(1) }}%</dd>
        <dt>Market cap</dt><dd>{{ valuation.market_cap | rs }}</dd>
      </dl>
    </div>
  </div>

  <div class="grid-a" style="margin-top:12px">
    <div class="card" style="grid-column:span 1">
      <h3 style="margin-top:0">Top 10 by turnover</h3>
      <div class="scroll"><table>
        <thead><tr><th class="l">Symbol</th><th>Price</th><th>Chg%</th><th>Turnover</th></tr></thead>
        <tbody>{% for r in top_turnover %}<tr>
          <td class="l"><span class="sym">{{ r.symbol.split(".")[0] }}</span>{% if r.symbol.endswith(".X0000") %}<span class="mut sm">.X</span>{% endif %}{% if r.mine %}<span class="star" title="on your watchlist">★</span>{% endif %}{% if r.excluded %}<span class="excl" title="excluded (conflict of interest)">⛔</span>{% endif %}</td>
          <td>{{ r.price | num }}</td><td class="{{ r.pct | cls }}">{{ r.pct | spct }}</td><td>{{ r.turnover | rs }}</td></tr>{% endfor %}</tbody>
      </table></div>
    </div>
    {% for title, rows in [("Top 10 gainers", gainers), ("Top 10 losers", losers)] %}
    <div class="card">
      <h3 style="margin-top:0">{{ title }} <span class="mut">· turnover ≥ {{ floor | rs }}</span></h3>
      <div class="scroll"><table>
        <thead><tr><th class="l">Symbol</th><th>Price</th><th>Chg%</th><th>Turnover</th></tr></thead>
        <tbody>{% for r in rows %}<tr>
          <td class="l"><span class="sym">{{ r.symbol.split(".")[0] }}</span>{% if r.symbol.endswith(".X0000") %}<span class="mut sm">.X</span>{% endif %}{% if r.mine %}<span class="star" title="on your watchlist">★</span>{% endif %}{% if r.excluded %}<span class="excl" title="excluded (conflict of interest)">⛔</span>{% endif %}</td>
          <td>{{ r.price | num }}</td><td class="{{ r.pct | cls }}">{{ r.pct | spct }}</td><td>{{ r.turnover | rs }}</td></tr>
        {% else %}<tr><td class="l mut" colspan="4">none above the floor</td></tr>{% endfor %}</tbody>
      </table></div>
    </div>
    {% endfor %}
    <div class="card">
      <h3 style="margin-top:0">Sectors (S&amp;P/CSE industry groups)</h3>
      <div class="scroll"><table>
        <thead><tr><th class="l">Sector</th><th>Index</th><th>Chg%</th><th>Turnover</th></tr></thead>
        <tbody>{% for s in sectors %}<tr><td class="l"><span class="trunc" title="{{ s.name }}">{{ s.name }}</span></td><td>{{ s.value | num }}</td>
          <td class="{{ s.pct | cls }}">{{ s.pct | spct }}</td><td>{{ s.turnover | rs }}</td></tr>{% endfor %}</tbody>
      </table></div>
    </div>
  </div>
</section>

<!-- Panel B ================================================================================ -->
<section class="panel" id="panel-b">
  <h2>B · My book <span class="mut sm" style="text-transform:none;letter-spacing:0">returns vs ASPI are price-only, in percentage points</span></h2>
  <div class="scroll"><table id="book">
    <thead><tr>
      <th class="l">Symbol</th><th>Price</th><th>Day</th><th>52-week range</th><th title="Today's volume ÷ mean of previous {{ avg_sessions }} sessions">Vol/avg</th>
      {% for w in windows %}<th title="Stock price return minus ASPI return, {{ w }}">vs ASPI {{ w }}</th>{% endfor %}
      <th>Mkt cap</th><th title="CSE-published beta vs TRI-ASI">β CSE</th>
    </tr></thead>
    <tbody>
    {% for g in book %}
      <tr class="grp"><td colspan="{{ 7 + windows | length }}">{{ g.group }}</td></tr>
      {% for r in g.rows %}
      <tr>
        <td class="l"><span class="sym">{{ r.symbol.split(".")[0] }}</span>{% if r.symbol.endswith(".X0000") %}<span class="mut sm">.X</span>{% endif %}{% if r.excluded %}<span class="excl" title="excluded: flagged, never held by model portfolios">⛔</span>{% endif %}<br><span class="name sm">{{ r.name }}</span></td>
        <td>{{ r.price | num }}</td>
        <td>{% if r.traded %}<span class="{{ r.change | cls }}">{{ r.change | signed }}</span><br><span class="sm {{ r.pct | cls }}">{{ r.pct | spct }}</span>{% else %}<span class="mut sm">no trade</span>{% endif %}</td>
        <td>{% if r.pos is not none %}<span class="rng"><span class="mut sm">{{ r.lo | num }}</span><span class="bar"><i style="left:calc({{ (r.pos * 100) | round(1) }}% - 1px)"></i></span><span class="mut sm">{{ r.hi | num }}</span></span>
            <br><span class="sm">{{ (r.pos * 100) | round(0) | int }}%</span>{% if r.range_flag %} <span class="flag" title="A >40% one-day price move in the last year suggests an unadjusted split, scrip or rights issue: the CSE's 52-week range is then not comparable with today's price.">⚠ unadjusted</span>{% endif %}
            {% else %}—{% endif %}</td>
        <td>{% if r.vol.value is not none %}<span class="{{ (r.vol.value - 1) | cls }}">{{ r.vol.value | num(1) }}×</span>{% elif r.vol.needed %}<span class="need">— ({{ r.vol.needed }} sessions needed)</span>{% else %}—{% endif %}</td>
        {% for w in windows %}{% set x = r.rel[w] %}
        <td>{% if x.value is not none %}<span class="{{ x.value | cls }}" title="stock {{ x.stock | spct }} · ASPI {{ x.aspi | spct }}">{{ (x.value * 100) | signed(1) }}</span>{% if x.flag %} <span class="flag" title="{{ x.flag }}">⚠</span>{% endif %}
            {% elif x.needed %}<span class="need">— ({{ x.needed }} sessions needed)</span>{% else %}<span class="need" title="{{ x.flag }}">—</span>{% endif %}</td>
        {% endfor %}
        <td>{{ r.mcap | rs }}</td>
        <td>{{ r.beta | num(2) }}</td>
      </tr>
      {% endfor %}
    {% endfor %}
    </tbody>
  </table></div>
  <p class="mut sm">Foreign holding % is not published by the CSE API (null for every stock), so it is not shown. See docs/API_NOTES.md (D3).</p>
</section>

<!-- Panel C ================================================================================ -->
<section class="panel" id="panel-c">
  <h2>C · Disclosures
    <span class="toggle" role="group" aria-label="Filter disclosures">
      <button type="button" data-scope="mine" aria-pressed="true">My universe</button>
      <button type="button" data-scope="all" aria-pressed="false">All market</button>
    </span>
  </h2>
  <ul class="feed" id="feed">
  {% for a in announcements %}
    <li data-mine="{{ 1 if a.mine else 0 }}">
      <div class="top"><span class="date">{{ a.date }}</span><span class="tag {{ a.tag }}">{{ a.tag }}</span>
        <span class="sym">{{ a.symbol or "—" }}</span>{% if a.excluded %}<span class="excl" title="excluded company">⛔</span>{% endif %}
        <span class="co sm">{{ a.company }}</span></div>
      <span class="title">{% if a.url %}<a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.title }}</a>{% else %}{{ a.title }} <span class="mut sm">(no PDF)</span>{% endif %}</span>
      <span class="cat">{{ a.category }}</span>
    </li>
  {% endfor %}
  </ul>
  <p class="mut sm" id="feed-empty" hidden>Nothing from your universe in the last {{ announcement_days }} days.</p>
</section>

<!-- Panel D ================================================================================ -->
<section class="panel" id="panel-d">
  <h2>D · Portfolio lab
    {% if labx %}<span class="mut sm" style="text-transform:none;letter-spacing:0">series {{ labx.lab.series }} · market proxy {{ labx.lab.market_proxy }}</span>{% endif %}
  </h2>
  <p class="note">Model outputs from the stated assumptions, not investment advice.
    Method and every formula: <a href="{{ labx.methods_url if labx else '#' }}" target="_blank" rel="noopener">docs/METHODS.md</a>.</p>
  {% if not labx %}
    <p class="mut">The portfolio lab has not run yet (<code>python -m cse.lab</code>).</p>
  {% else %}
  {% set L = labx.lab %}
  {% if labx.failed %}
    <div class="banner" style="margin:8px 0">⚠ The latest lab run failed ({{ labx.failed.run_at_utc }} UTC): {{ labx.failed.message }}. Showing the last good output, session {{ L.session }}.</div>
  {% endif %}
  {% if L.status != "ok" %}
    <div class="banner" style="margin:8px 0">{{ "Waiting for history" if L.status == "waiting" else "Constraints infeasible" }}: {{ L.message }}</div>
  {% endif %}
  {% if L.preview %}
    <div class="banner preview" style="margin:8px 0">PREVIEW — estimated on the {{ L.preview.weeks }} weekly returns that exist ({{ L.preview.universe }} stocks pass the other filters).
      Nothing below is traded or recorded; the live record starts on the first run with {{ L.config.min_history_weeks }} weeks.
      {% if L.preview.infeasible %}Preview constraints infeasible: {{ L.preview.infeasible }}{% endif %}</div>
  {% endif %}
  <dl class="kv lab-assume">
    <dt>Risk-free (12-m T-bill)</dt><dd>{{ (L.config.risk_free_annual * 100) | num(2) }}%</dd>
    <dt>Equity risk premium (assumption)</dt><dd>{{ (L.config.equity_risk_premium * 100) | num(2) }}%</dd>
    <dt>Cost per side</dt><dd>{{ (L.config.cost_per_side * 100) | num(2) }}%</dd>
    <dt>Caps: stock / sector</dt><dd>{{ (L.config.max_weight * 100) | num(0) }}% / {{ (L.config.max_sector_weight * 100) | num(0) }}%</dd>
    <dt>Universe</dt><dd>{{ L.universe | length }} live{% if L.preview %} · preview {{ L.preview.universe }}{% endif %} · {{ L.dropped | length }} dropped</dd>
    {% if L.n_weeks %}<dt>Estimation window</dt><dd>{{ L.n_weeks }} weekly returns, {{ L.weeks[0] }} → {{ L.weeks[1] }}</dd>
    <dt>Ledoit-Wolf shrinkage</dt><dd>{{ L.shrinkage | num(3) }}</dd>{% endif %}
  </dl>

  {% if L.portfolios %}
  <div class="grid-d">
    <div class="card">
      <h3 style="margin-top:0">Risk / return (CAPM expected return vs Ledoit-Wolf volatility, annual)</h3>
      <div class="chart-lg"><canvas id="rr-chart" aria-label="Expected return against volatility for every universe stock, the constrained efficient frontier and the model portfolios"></canvas></div>
      <p class="mut sm">Grey: universe stocks. Line: efficient frontier under the caps. Points: model portfolios.
        <span id="rr-offscale"></span></p>
    </div>
    <div class="card">
      <h3 style="margin-top:0">Model portfolios</h3>
      <div class="scroll"><table>
        <thead><tr><th class="l">Portfolio</th><th>Exp. return</th><th>Volatility</th><th>Sharpe</th><th>Holdings</th><th>Constraints</th></tr></thead>
        <tbody>{% for k, p in L.portfolios.items() %}<tr>
          <td class="l"><span class="swatch" data-series="{{ k }}"></span>{{ p.name }}</td>
          <td>{{ (p.er * 100) | num(1) }}%</td><td>{{ (p.vol * 100) | num(1) }}%</td><td>{{ p.sharpe | num(2) }}</td><td>{{ p.n }}</td>
          <td>{% if p.constraints %}{{ "✓ all hold" if p.constraints.ok else "✗" }}{% else %}<span class="mut">n/a (1/N)</span>{% endif %}</td></tr>{% endfor %}</tbody>
      </table></div>
    </div>
  </div>

  {% for k, p in L.portfolios.items() %}
  <details class="pf">
    <summary><span class="swatch" data-series="{{ k }}"></span>{{ p.name }} — {{ p.n }} holdings · top sector {{ (p.sectors | list)[0] }} {{ ((p.sectors.values() | list)[0] * 100) | num(1) }}%</summary>
    <div class="grid-d">
      <div class="scroll"><table>
        <thead><tr><th class="l">Symbol</th><th class="l">Sector</th><th>Weight</th><th title="Share of portfolio variance">Risk contr.</th><th>Cap</th><th>Exp. ret.</th></tr></thead>
        <tbody>{% for h in p.holdings %}<tr><td class="l sym">{{ h.symbol.split(".")[0] }}{% if h.symbol.endswith(".X0000") %}<span class="mut sm">.X</span>{% endif %}</td>
          <td class="l"><span class="trunc">{{ h.sector }}</span></td><td>{{ (h.weight * 100) | num(2) }}%</td>
          <td>{{ (h.risk_contribution * 100) | num(2) }}%</td><td class="mut">{{ (h.cap * 100) | num(1) }}%</td><td>{{ (h.er * 100) | num(1) }}%</td></tr>{% endfor %}</tbody>
      </table></div>
      <div><table>
        <thead><tr><th class="l">Sector</th><th>Weight</th></tr></thead>
        <tbody>{% for sec, wt in p.sectors.items() %}<tr><td class="l">{{ sec }}</td><td>{{ (wt * 100) | num(1) }}%</td></tr>{% endfor %}</tbody>
      </table>
      {% if p.groups %}
      <table style="margin-top:8px">
        <thead><tr><th class="l" title="Companies whose ownership traces to the same holder (METHODS §10.5)">Ownership group</th><th>Weight</th></tr></thead>
        <tbody>{% for g, wt in p.groups.items() %}{% if loop.index <= 6 %}<tr><td class="l"><span class="trunc" style="max-width:18em" title="{{ L.group_labels.get(g, g) }}">{{ L.group_labels.get(g, g) }}</span></td><td>{{ (wt * 100) | num(1) }}%</td></tr>{% endif %}{% endfor %}</tbody>
      </table>
      {% if L.config.max_group_weight %}<p class="mut sm">Cap {{ (L.config.max_group_weight * 100) | num(0) }}% per group.</p>{% endif %}
      {% endif %}
      </div>
    </div>
  </details>
  {% endfor %}
  {% endif %}

  <h3>Live record{% if labx.inception %} since {{ labx.inception }}{% endif %}</h3>
  {% if labx.record %}
  <div class="grid-d">
    <div class="card"><div class="chart-lg"><canvas id="nav-chart" aria-label="Value of each model portfolio, indexed to 100 at inception"></canvas></div></div>
    <div class="card"><div class="scroll"><table>
      <thead><tr><th class="l">Portfolio</th><th>Value (Rs)</th><th>Return</th><th>Volatility</th><th>Max drawdown</th></tr></thead>
      <tbody>{% for r in labx.record %}<tr><td class="l"><span class="swatch" data-series="{{ r.key }}"></span>{{ r.label }}</td>
        <td>{{ r.nav | rs }}</td>
        {% if r.stats.weeks >= labx.stats_min_weeks %}
          <td class="{{ r.stats['return'] | cls }}">{{ r.stats['return'] | spct }}</td><td>{{ r.stats.vol | spct }}</td><td class="dn">{{ r.stats.max_drawdown | spct }}</td>
        {% else %}<td colspan="3" class="need">shown after {{ labx.stats_min_weeks }} weeks ({{ labx.stats_min_weeks - r.stats.weeks }} to go)</td>{% endif %}
      </tr>{% endfor %}</tbody>
    </table></div>
    <p class="mut sm">No performance is shown for any date before inception. History files are append-only; a method change starts a new series.</p></div>
  </div>
  {% else %}<p class="mut">No record yet. Inception is the first run where the universe passes the filters.</p>{% endif %}

  {% if labx.flags %}
  <h3>Rebalance flags and trade list <span class="mut">· scaled to {{ L.config.portfolio_size_lkr | rs }}</span></h3>
  <div class="grid-d">
  {% for k, tl in labx.flags.items() %}
    <div class="card">
      <h3 style="margin-top:0"><span class="swatch" data-series="{{ k }}"></span>{{ L.labels[k] }}</h3>
      {% set rows = (tl.today_scaled or []) + (tl.next_close or []) %}
      {% if rows %}<div class="scroll"><table>
        <thead><tr><th class="l">When</th><th class="l">Symbol</th><th class="l">Side</th><th>Shares</th><th>Amount</th><th>Est. cost</th><th title="Trade ÷ median daily turnover">× med. TO</th></tr></thead>
        <tbody>{% for t in rows %}<tr><td class="l mut">{{ t.when }}</td><td class="l sym">{{ t.symbol.split(".")[0] }}</td>
          <td class="l {{ 'up' if t.side == 'add' else 'dn' }}">{{ "+ add" if t.side == "add" else "− trim" }}</td>
          <td>{{ t.shares | num(0) }}</td><td>{{ t.amount | rs }}</td><td>{{ t.cost | rs }}</td><td>{{ t.x_median_turnover | num(2) }}</td></tr>{% endfor %}</tbody>
      </table></div>
      {% else %}<p class="mut sm">No names outside their drift band; nothing to trade.</p>{% endif %}
    </div>
  {% endfor %}
  </div>
  {% endif %}

  {% set urgent = L.needs_review | selectattr("affects_holdings") | list %}
  {% if urgent %}<div class="banner" style="margin:8px 0">⚠ {{ urgent | length }} unconfirmed corporate action{{ "s" if urgent | length > 1 }} on stocks the model portfolios hold
    ({% for r in urgent %}{{ r.symbol.split(".")[0] }} ex {{ r.ex_date or "date tbc" }}{{ ", " if not loop.last }}{% endfor %}).
    Confirm before the ex-date: the record books actions on their ex-date and never restates history.</div>{% endif %}
  <h3>Corporate actions to confirm ({{ L.needs_review | length }})</h3>
  {% if L.needs_review %}
  <p class="mut sm">Not used for returns or the record until confirmed in <code>config/corporate_actions_review.yaml</code>. Check each against its PDF.</p>
  <div class="scroll"><table>
    <thead><tr><th class="l">Id</th><th class="l">Symbol</th><th class="l">Type</th><th>Ex-date</th><th>Amount</th><th>Ratio (new:held)</th><th>Sub. price</th><th class="l">Note</th><th class="l">Source</th></tr></thead>
    <tbody>{% for r in L.needs_review | sort(attribute="affects_holdings", reverse=True) %}<tr><td class="l mut sm">{% if r.affects_holdings %}<span class="flag" title="held by a model portfolio">⚠ </span>{% endif %}{{ r.id }}</td><td class="l sym">{{ r.symbol.split(".")[0] }}</td><td class="l">{{ r.type }}</td>
      <td>{{ r.ex_date or "—" }}</td><td>{{ r.amount_per_share or "—" }}</td>
      <td>{% if r.ratio_new %}{{ r.ratio_new }}:{{ r.ratio_held }}{% else %}—{% endif %}</td><td>{{ r.subscription_price or "—" }}</td>
      <td class="l sm wrap">{{ r.note }}</td><td class="l">{% if r.source_url %}<a href="{{ r.source_url }}" target="_blank" rel="noopener">PDF</a>{% endif %}</td></tr>{% endfor %}</tbody>
  </table></div>
  {% else %}<p class="mut sm">None pending. {{ L.actions_used }} corporate actions in use.</p>{% endif %}

  <details class="pf">
    <summary>Universe: {{ L.universe | length }} included, {{ L.dropped | length }} dropped (with reasons)</summary>
    <div class="scroll"><table>
      <thead><tr><th class="l">Symbol</th><th class="l">Name</th><th class="l">Reason dropped</th></tr></thead>
      <tbody>{% for d in L.dropped %}<tr><td class="l sym">{{ d.symbol }}</td><td class="l mut"><span class="trunc" style="max-width:18em">{{ d.name }}</span></td><td class="l wrap">{{ d.reason }}</td></tr>{% endfor %}</tbody>
    </table></div>
  </details>
  {% if L.stocks %}
  <details class="pf">
    <summary>Per-stock estimates ({{ L.stocks | length }})</summary>
    <div class="scroll"><table>
      <thead><tr><th class="l">Symbol</th><th class="l">Sector</th><th>Exp. ret.</th><th>Vol</th><th title="Dimson: current + lagged slope">β</th><th>β₀</th><th>β₁</th><th title="mean |weekly return| / weekly turnover (Rs mn)">Amihud</th><th>Med. turnover</th><th class="l">Turnover data</th><th>Cap</th></tr></thead>
      <tbody>{% for s in L.stocks | sort(attribute="er", reverse=True) %}<tr><td class="l sym">{{ s.symbol.split(".")[0] }}{% if s.symbol.endswith(".X0000") %}<span class="mut sm">.X</span>{% endif %}</td>
        <td class="l"><span class="trunc">{{ s.sector }}</span></td><td>{{ (s.er * 100) | num(1) }}%</td><td>{{ (s.vol * 100) | num(1) }}%</td>
        <td>{{ s.beta | num(2) }}</td><td class="mut">{{ s.beta_current | num(2) }}</td><td class="mut">{{ s.beta_lag | num(2) }}</td>
        <td>{{ s.amihud | num(4) }}</td><td>{{ s.median_turnover | rs }}</td><td class="l mut">{{ s.turnover_source }}</td><td>{{ (s.cap * 100) | num(1) }}%</td></tr>{% endfor %}</tbody>
    </table></div>
  </details>
  {% endif %}
  {% endif %}
</section>
</main>

<footer>
  Data: public cse.lk JSON API, fetched once per trading day. Every figure is reproducible from <code>data/</code> in the repository.
  Index returns, 52-week figures and price history are unadjusted for corporate actions unless stated. Not investment advice.
</footer>

<script type="application/json" id="charts-data">{{ charts_json | safe }}</script>
<script type="application/json" id="meta-data">{{ meta_json | safe }}</script>
<script type="application/json" id="lab-data">{{ lab_json | safe }}</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script>
(function () {
  // Disclosure toggle -------------------------------------------------------------------------
  var buttons = document.querySelectorAll('.toggle button');
  var items = document.querySelectorAll('#feed li');
  function setScope(scope) {
    var shown = 0;
    buttons.forEach(function (b) { b.setAttribute('aria-pressed', String(b.dataset.scope === scope)); });
    items.forEach(function (li) { var on = scope === 'all' || li.dataset.mine === '1'; li.hidden = !on; if (on) shown++; });
    document.getElementById('feed-empty').hidden = shown > 0;
    try { localStorage.setItem('cse-feed-scope', scope); } catch (e) {}
  }
  buttons.forEach(function (b) { b.addEventListener('click', function () { setScope(b.dataset.scope); }); });
  var saved = null; try { saved = localStorage.getItem('cse-feed-scope'); } catch (e) {}
  setScope(saved === 'all' ? 'all' : 'mine');

  // Staleness banner: compare the data's session with the latest weekday session whose daily run
  // (16:30 Sri Lanka time, + 1 h grace) should have finished. Holidays can trigger it falsely.
  var meta = JSON.parse(document.getElementById('meta-data').textContent);
  function slt(d) { return new Date(d.getTime() + (d.getTimezoneOffset() + 330) * 60000); }
  function iso(d) { return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); }
  var now = slt(new Date());
  var exp = new Date(now);
  if (now.getHours() * 60 + now.getMinutes() < 17 * 60 + 30) exp.setDate(exp.getDate() - 1);
  while (exp.getDay() === 0 || exp.getDay() === 6) exp.setDate(exp.getDate() - 1);
  var behind = 0, d = new Date(exp);
  while (iso(d) > meta.session && behind < 60) { if (d.getDay() !== 0 && d.getDay() !== 6) behind++; d.setDate(d.getDate() - 1); }
  if (behind > 0) {
    var el = document.getElementById('stale');
    el.textContent = '⚠ Data is from ' + meta.session + ': ' + behind + ' weekday session' + (behind > 1 ? 's' : '') +
      ' since then (latest expected ' + iso(exp) + ') are missing. The daily run may have failed, or the market was closed for a holiday.';
    el.hidden = false;
  }

  // Index charts: one series each, single axis, crosshair tooltip --------------------------
  if (!window.Chart) return;
  var series = JSON.parse(document.getElementById('charts-data').textContent);
  var css = getComputedStyle(document.documentElement);
  var ink2 = css.getPropertyValue('--text-2').trim(), rule = css.getPropertyValue('--rule').trim();
  var accent = css.getPropertyValue('--accent').trim();
  var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  document.querySelectorAll('canvas[data-chart]').forEach(function (cv) {
    var s = series[cv.dataset.chart]; if (!s || !s.values.length) return;
    new Chart(cv, {
      type: 'line',
      data: { labels: s.dates, datasets: [{ data: s.values, borderColor: accent, borderWidth: 2, pointRadius: 0, pointHoverRadius: 4, tension: 0 }] },
      options: {
        responsive: true, maintainAspectRatio: false, animation: false,
        interaction: { mode: 'index', intersect: false },
        plugins: { legend: { display: false },
          tooltip: { displayColors: false, callbacks: { label: function (c) { return c.parsed.y.toLocaleString('en-US', { minimumFractionDigits: 2 }); } } } },
        scales: {
          x: { ticks: { color: ink2, maxTicksLimit: 4, maxRotation: 0, autoSkipPadding: 18, font: { family: 'monospace', size: 10 },
                 callback: function (v) { var d = this.getLabelForValue(v); return MONTHS[+d.slice(5, 7) - 1] + ' ' + d.slice(2, 4); } },
               grid: { display: false } },
          y: { position: 'right', ticks: { color: ink2, maxTicksLimit: 4, font: { family: 'monospace', size: 10 } }, grid: { color: rule } }
        }
      }
    });
  });

  // Panel D charts ------------------------------------------------------------------------
  var lab = JSON.parse(document.getElementById('lab-data').textContent || '{}');
  var COLORS = { min_variance: '#3987e5', risk_parity: '#d95926', max_sharpe: '#199e70',
                 equal_weight: '#c98500', market: '#d55181', my_book: '#9085e9' };
  var ink = css.getPropertyValue('--text').trim(), muted = css.getPropertyValue('--muted').trim();
  var surface = css.getPropertyValue('--surface-2').trim();
  var pct = function (v) { return (v * 100).toFixed(0) + '%'; };
  var labelPlugin = { id: 'pointLabels', afterDatasetsDraw: function (chart) {
    // Direct labels for the portfolio points, pushed apart vertically so they never overlap.
    var ctx = chart.ctx, items = [];
    chart.data.datasets.forEach(function (ds, i) {
      if (!ds.pointLabels) return;
      chart.getDatasetMeta(i).data.forEach(function (pt, j) { items.push({ x: pt.x, y: pt.y, ly: pt.y, text: ds.pointLabels[j] }); });
    });
    items.sort(function (a, b) { return a.y - b.y; });
    for (var k = 1; k < items.length; k++) if (items[k].ly - items[k - 1].ly < 14) items[k].ly = items[k - 1].ly + 14;
    ctx.save(); ctx.font = '11px monospace'; ctx.textBaseline = 'middle';
    items.forEach(function (it) {
      ctx.strokeStyle = muted; ctx.lineWidth = 1;
      if (Math.abs(it.ly - it.y) > 2) { ctx.beginPath(); ctx.moveTo(it.x + 6, it.y); ctx.lineTo(it.x + 14, it.ly); ctx.stroke(); }
      ctx.fillStyle = surface; var w = ctx.measureText(it.text).width; ctx.fillRect(it.x + 15, it.ly - 7, w + 4, 14);
      ctx.fillStyle = ink; ctx.fillText(it.text, it.x + 17, it.ly);
    });
    ctx.restore(); } };
  var rrEl = document.getElementById('rr-chart');
  if (rrEl && lab.rr) {
    // x-axis: frontier/portfolios and the 95th percentile of stocks; the rest are counted, not hidden silently.
    var vols = lab.rr.stocks.map(function (p) { return p.x; }).sort(function (a, b) { return a - b; });
    var p95 = vols.length ? vols[Math.floor(0.95 * (vols.length - 1))] : 1;
    var anchor = Math.max.apply(null, lab.rr.frontier.concat(lab.rr.portfolios).map(function (p) { return p.x; }).concat([p95]));
    var xmax = Math.ceil(anchor * 1.1 * 10) / 10;
    var off = lab.rr.stocks.filter(function (p) { return p.x > xmax; });
    if (off.length) document.getElementById('rr-offscale').textContent = off.length + ' stock' + (off.length > 1 ? 's' : '') +
      ' beyond ' + pct(xmax) + ' volatility not shown: ' + off.map(function (p) { return p.label + ' ' + pct(p.x); }).join(', ') + '.';
    var ds = [
      { type: 'scatter', label: 'Universe stocks', data: lab.rr.stocks, backgroundColor: muted, pointRadius: 2.5, pointHoverRadius: 5, order: 3 },
      { type: 'line', label: 'Efficient frontier', data: lab.rr.frontier, borderColor: ink, borderWidth: 2, pointRadius: 0, tension: 0, order: 2 }
    ];
    lab.rr.portfolios.forEach(function (p) {
      ds.push({ type: 'scatter', label: p.label, data: [{ x: p.x, y: p.y }], backgroundColor: COLORS[p.key],
                borderColor: surface, borderWidth: 2, pointRadius: 7, pointHoverRadius: 9, pointLabels: [p.label], order: 1 });
    });
    new Chart(rrEl, { data: { datasets: ds }, plugins: [labelPlugin],
      options: { responsive: true, maintainAspectRatio: false, animation: false,
        plugins: { legend: { display: false },
          tooltip: { callbacks: { label: function (c) { var r = c.raw; return (r.label || c.dataset.label) + ': return ' + pct(r.y) + ', vol ' + pct(r.x); } } } },
        scales: { x: { type: 'linear', min: 0, max: xmax, title: { display: true, text: 'Volatility (annual)', color: ink2 }, ticks: { color: ink2, callback: pct }, grid: { color: rule } },
                  y: { title: { display: true, text: 'CAPM expected return', color: ink2 }, ticks: { color: ink2, callback: pct }, grid: { color: rule } } } } });
  }
  var navEl = document.getElementById('nav-chart');
  if (navEl && lab.record && lab.order && lab.order.length) {
    var first = lab.record[lab.order[0]];
    new Chart(navEl, { type: 'line',
      data: { labels: first.dates, datasets: lab.order.map(function (k) {
        return { label: lab.labels[k] || k, data: lab.record[k].values, borderColor: COLORS[k], backgroundColor: COLORS[k],
                 borderWidth: 2, pointRadius: first.dates.length < 3 ? 4 : 0, tension: 0 }; }) },
      options: { responsive: true, maintainAspectRatio: false, animation: false, interaction: { mode: 'index', intersect: false },
        plugins: { legend: { position: 'bottom', labels: { color: ink2, boxWidth: 10, font: { family: 'monospace', size: 11 } } } },
        scales: { x: { ticks: { color: ink2, maxTicksLimit: 6, maxRotation: 0 }, grid: { display: false } },
                  y: { title: { display: true, text: 'Indexed to 100 at inception', color: ink2 }, ticks: { color: ink2 }, grid: { color: rule } } } } });
  }
})();
</script>
</body>
</html>
